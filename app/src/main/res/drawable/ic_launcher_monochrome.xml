<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome icon for Android 13+ themed icons (Material You) and
    Samsung One UI themed icon packs. Android tints this with the
    system/wallpaper accent color so it looks native on any phone.
    Must be a single-layer vector with white fill on transparent bg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bookmark ribbon — white so system can tint with any wallpaper color -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 42,30 L 66,30 A 6,6 0 0 1 72,36 L 72,78 L 54,69 L 36,78 L 36,36 A 6,6 0 0 1 42,30 Z" />

</vector>
